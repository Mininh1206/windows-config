{
  "id": "hermes_agent",
  "name": "Hermes Agent CLI & Soul",
  "category": "herramientas",
  "priority": 2,
  "depends_on": ["python", "git"],
  "install": {
    "type": "script",
    "winget_id": null,
    "choco_id": null,
    "scoop_id": null,
    "local_installer": null,
    "silent_args": null,
    "check_command": "hermes",
    "target_drive_supported": true,
    "refresh_env_after": true
  },
  "requirements": {
    "MinRAM_GB": 4.0,
    "MinDisk_GB": 1.0,
    "RequireAdmin": false
  },
  "config": {
    "has_direct_config": true,
    "files": [
      {
        "source": "SOUL.md",
        "destination": "$env:LOCALAPPDATA/hermes/SOUL.md",
        "create_backup": true
      },
      {
        "source": "config.yaml",
        "destination": "$env:LOCALAPPDATA/hermes/config.yaml",
        "create_backup": true
      }
    ],
    "commands": [
      "powershell.exe -ExecutionPolicy Bypass -File \"$PSScriptRoot/configure.ps1\""
    ],
    "environment_vars": {}
  }
}
