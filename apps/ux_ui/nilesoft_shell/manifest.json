{
  "id": "nilesoft_shell",
  "name": "Nilesoft Shell Context Menu",
  "category": "ux_ui",
  "priority": 2,
  "depends_on": [],
  "install": {
    "type": "winget",
    "package_id": "Nilesoft.Shell",
    "args": "/VERYSILENT",
    "check_command": "shell",
    "target_drive_supported": true,
    "refresh_env_after": false
  },
  "requirements": {
    "MinRAM_GB": 2.0,
    "MinDisk_GB": 0.2,
    "RequireAdmin": true
  },
  "config": {
    "has_direct_config": true,
    "files": [
      {
        "source": "shell.nss",
        "destination": "$env:ProgramFiles/Nilesoft Shell/shell.nss",
        "create_backup": true
      }
    ],
    "commands": [],
    "environment_vars": {}
  }
}
