  },
  "requirements": {
    "MinRAM_GB": 4.0,
    "MinDisk_GB": 3.0,
    "RequireAdmin": false
  },
  "config": {
    "has_direct_config": true,
    "files": [],
    "commands": [
      "flutter doctor"
    ],
    "environment_vars": {}
  }
}
