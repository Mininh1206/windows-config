{
  "id": "flutter",
  "name": "Flutter SDK",
  "category": "frameworks",
  "priority": 1,
  "depends_on": ["git"],
  "install": {
    "type": "winget",
    "winget_id": "Google.Flutter",
    "choco_id": null,
    "scoop_id": null,
    "local_installer": null,
    "silent_args": "/S",
