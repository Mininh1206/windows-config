{
  "id": "flutter",
  "name": "Flutter SDK",
  "category": "frameworks",
  "priority": 1,
  "depends_on": [
    "git",
    "chocolatey"
  ],
  "install": {
    "type": "choco",
    "package_id": "flutter",
    "args": "/S",
    "check_command": "flutter",
    "target_drive_supported": true,
    "refresh_env_after": true
  },
  "requirements": {
    "MinRAM_GB": 4.0,
    "MinDisk_GB": 3.0,
    "RequireAdmin": false
  },
  "config": {
    "has_direct_config": true,
    "files": [],
    "commands": [],
    "environment_vars": {}
  }
}
