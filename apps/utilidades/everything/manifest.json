      "if (Test-Path '$env:ProgramFiles/Everything/Everything.exe') { Start-Process -FilePath '$env:ProgramFiles/Everything/Everything.exe' -ArgumentList '-install-service' -Verb RunAs -Wait -ErrorAction SilentlyContinue }"
