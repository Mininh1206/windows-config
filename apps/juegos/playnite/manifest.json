{
  "id": "playnite",
  "name": "Playnite Game Launcher",
  "category": "juegos",
  "priority": 3,
  "depends_on": [],
  "install": {
    "type": "winget",
    "winget_id": "Playnite.Playnite",
    "local_installer": null,
    "silent_args": "/VERYSILENT",
    "check_command": "playnite",
    "target_drive_supported": true,
    "refresh_env_after": false
  },
  "requirements": {
    "MinRAM_GB": 4.0,
    "MinDisk_GB": 0.5,
    "RequireAdmin": false
  },
  "config": {
    "has_direct_config": true,
    "restart_process": [
      "Playnite.DesktopApp",
      "Playnite.FullscreenApp"
    ],
    "files": [
      {
        "source": "config.json",
        "destination": "$env:APPDATA/Playnite/config.json",
        "create_backup": true
      }
    ],
    "commands": [],
    "environment_vars": {}
  }
}
